{
  "sort_version": "Version 7",
  "phase": "Phase 4 — Fixed-Point Structure",
  "tolerances": {
    "epsilon_convergence": 1e-10,
    "epsilon_norm": 1e-10,
    "epsilon_repeatability": 1e-10
  },
  "iteration": {
    "max_iterations": 1000,
    "min_iterations": 5,
    "stop_when_converged": true,
    "record_full_series": true,
    "iteration_rule": "H_after_pi_kappa",
    "k_value": 1.0
  },
  "synthetic_states": {
    "initial_state_count": 32,
    "state_dimension": 22,
    "seed_reference": "../phase_0_setup/seed_config.json"
  },
  "norm_type": "frobenius",
  "convergence": {
    "criterion": "successive_difference",
    "classification_labels": [
      "convergent",
      "neutral",
      "oscillatory",
      "divergent"
    ]
  },
  "norm_tracking": {
    "mode": "tracked_and_classified",
    "strict_norm_preservation_required": false,
    "classification_labels": [
      "norm-invariant",
      "norm-drifting",
      "contractive-projection"
    ],
    "classification_rule": "Norm drift is recorded and classified. Norm drift caused by projection contraction is not interpreted as physical energy loss and does not fail Gate 4 if explicitly classified."
  },
  "stability": {
    "repeat_same_seed": true,
    "perturbation_test": true,
    "perturbation_scale": 1e-6,
    "classification_labels": [
      "attractor",
      "neutral",
      "divergent"
    ],
    "classification_rule": "Repeatability must pass epsilon_repeatability. Perturbation response is classified as attractor, neutral, or divergent; only divergent or unclassified cases fail Gate 4."
  },
  "inputs": {
    "operator_registry": "input/operator_registry.json",
    "projection_operator_ref": "input/projection_operator_ref.json",
    "global_projector_ref": "input/global_projector_ref.json",
    "env_spec": "../phase_0_setup/env_spec.yaml",
    "seed_config": "../phase_0_setup/seed_config.json",
    "run_manifest": "../phase_0_setup/run_manifest.json",
    "operator_integrity_report": "../phase_1_operator_integrity/outputs/operator_integrity_report.json",
    "kernel_norm_report": "../phase_2_projection_kernel/outputs/kernel_norm_report.json",
    "projector_validation": "../phase_3_global_projector/outputs/projector_validation.json",
    "closure_test_report": "../phase_3_global_projector/outputs/closure_test_report.json"
  },
  "outputs": {
    "fixed_point_metrics": "outputs/fixed_point_metrics.json",
    "convergence_series": "outputs/convergence_series.csv",
    "norm_invariance_report": "outputs/norm_invariance_report.json",
    "iteration_stability": "outputs/iteration_stability.json"
  },
  "non_claims": [
    "Phase 4 validates iterative numerical behavior on synthetic states only.",
    "Phase 4 iteration is not physical time evolution.",
    "Phase 4 does not introduce Level-1 dynamics.",
    "Phase 4 does not use empirical data.",
    "Phase 4 does not constitute SWORD execution.",
    "Phase 4 does not prove physical attractors.",
    "Phase 4 does not prove minimality.",
    "Phase 4 does not prove structural necessity."
  ]
}
